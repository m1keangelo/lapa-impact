# LAPA Mission Colombia — environment variables.
# Copy this file to `.env` for local dev:  cp .env.example .env
# `.env` is gitignored — NEVER commit real credentials. On Vercel, set these
# same names in Project Settings → Environment Variables (platform builds
# do not read your local .env).

# --- Firebase (6) ---------------------------------------------------------
# All six come from ONE place: Firebase Console → your project →
# Project settings (gear icon) → "Your apps" → Web app (</>) → SDK setup
# and configuration → the `firebaseConfig` object.

# Firebase Console → Project settings → Your apps → firebaseConfig.apiKey
VITE_FIREBASE_API_KEY=your-api-key
# firebaseConfig.authDomain — usually <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# firebaseConfig.projectId — shown at the top of Project settings
VITE_FIREBASE_PROJECT_ID=your-project-id
# firebaseConfig.storageBucket — usually <project-id>.appspot.com (only the
# config value is needed; Firebase Storage itself is not used by this app)
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# firebaseConfig.messagingSenderId — numeric sender id
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# firebaseConfig.appId — looks like 1:000000000000:web:abcdef123456
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# --- Cloudinary (2) -------------------------------------------------------
# Cloudinary Console → Dashboard → "Cloud name" (top-left of the page).
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Cloudinary Console → Settings (gear) → Upload → Upload presets →
# "Add upload preset" with Signing Mode = **Unsigned** → the preset's name.
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# --- Stripe donations (2) -------------------------------------------------
# Stripe Dashboard → Payment Links → your link URL (https://buy.stripe.com/…).
# The link's confirmation page must redirect to
#   https://YOURAPP/donate/success?session_id={CHECKOUT_SESSION_ID}
# Leave unset/empty to hide all Donate buttons (demo mode).
VITE_STRIPE_PAYMENT_LINK=
# Base URL of the deployed Firebase Cloud Functions, e.g.
#   https://us-central1-your-project-id.cloudfunctions.net
# Used by /donate/success to poll `lookupDonation` for the donor code.
# Leave unset/empty and the success page shows its "unavailable" state.
VITE_FUNCTIONS_BASE_URL=
