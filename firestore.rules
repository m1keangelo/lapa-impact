rules_version = '2';

// LAPA Mission Colombia — Firestore security rules.
//
// Model: the public ledger is readable by everyone (donors watch it live
// without logging in). Donor codes are sensitive: they can be looked up
// one at a time (the donor login flow), but the collection can NEVER be
// listed, so codes cannot be enumerated.
//
// Staff model: accounts are created by hand in the Firebase console
// (Authentication → Add user); there is no public sign-up. A staff/{uid}
// doc decides what each account can do:
//   admin   — everything: approve field reports, post updates/photos,
//             record money in/out, manage the team.
//   finance — money desk: record donations/purchases, touch stats.
//   field   — volunteers: submit fieldReports, nothing else.
// The FIRST person to sign in claims the admin role via the bootstrap
// card (self-create of their own staff doc); after that only an existing
// admin can create/update staff docs.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function isStaff() {
      return signedIn() && staffDoc().active == true;
    }
    function isAdmin() {
      return isStaff() && staffDoc().role == 'admin';
    }
    function canWriteMoney() {
      return isStaff() && staffDoc().role in ['admin', 'finance'];
    }
    // The primary organizer (FINAL(2) PART 69/109): an admin whose staff
    // doc carries primary == true. Only they can publish the event.
    function isPrimaryAdmin() {
      return isAdmin() && staffDoc().primary == true;
    }

    // ── Write-validation helpers (security pass) ──────────────────
    // Bounded money: integer cents, $0.01 … $1,000,000.
    function validAmount(v) {
      return v is int && v > 0 && v <= 100000000;
    }
    function boundedStr(v, max) {
      return v is string && v.size() <= max;
    }
    // Optional string field: absent OR bounded string.
    function optStr(data, key, max) {
      return !data.keys().hasAny([key]) || boundedStr(data.get(key, ''), max);
    }
    // HIGH-RISK: the ticket/donation destination may ONLY point at our
    // Stripe payment links — never an arbitrary URL.
    function validTicketUrl(v) {
      return v == null || (v is string
        && (v.matches('^https://buy\\.stripe\\.com/.*')
            || v.matches('^https://donate\\.stripe\\.com/.*')));
    }
    // Event imagery must be https (Cloudinary in practice) and bounded.
    function validImageUrl(v) {
      return v == null || (v is string && v.size() <= 1000 && v.matches('^https://.*'));
    }
    function validCloudinaryUrl(v) {
      return v is string && v.size() <= 1000 && v.matches('^https://res\\.cloudinary\\.com/.*');
    }

    // staff/{uid} — roles. Self-read (role routing), admin lists the team.
    // Self-create is the bootstrap claim (admin role only, own uid only);
    // afterwards only an existing admin can add/update/deactivate staff.
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true);
      allow update, delete: if isAdmin();
    }

    // fieldReports/{id} — volunteer submissions. Any active staff member
    // can file one (as themselves, always starting 'submitted'); only an
    // admin can review (approve/reject) or read the whole queue.
    match /fieldReports/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow update, delete: if isAdmin();
    }

    // donors/{code} — code is the document ID. LEGACY: the 6-digit code
    // system is gone (final doc §58) and NO client reads this collection
    // anymore — reads are money-desk only, so donor PII can't be
    // brute-forced one code at a time. List stays closed.
    match /donors/{code} {
      allow get: if canWriteMoney();
      allow list: if false;
      allow create, update, delete: if canWriteMoney();
    }

    // donations/{id} — public ledger (read by everyone, written by money
    // desk). Validated shape: real money amounts, bounded text, server
    // timestamp. Historical records are NEVER rewritten or deleted by the
    // money desk — only an admin may correct them (and every correction
    // leaves an auditLogs entry).
    match /donations/{id} {
      allow read: if true;
      allow create: if canWriteMoney()
        && validAmount(request.resource.data.amount)
        && boundedStr(request.resource.data.donorName, 120)
        && optStr(request.resource.data, 'note', 500)
        && request.resource.data.timestamp is timestamp;
      allow update, delete: if isAdmin();
    }

    // transfers/{id} — money out to the field (purchases, vendors,
    // receipts). Same ledger rules: validated on create, admin-only
    // corrections afterwards.
    match /transfers/{id} {
      allow read: if true;
      allow create: if canWriteMoney()
        && validAmount(request.resource.data.amount)
        && boundedStr(request.resource.data.recipient, 160)
        && boundedStr(request.resource.data.purpose, 500)
        && request.resource.data.timestamp is timestamp
        && (!request.resource.data.keys().hasAny(['proofUrl'])
            || validCloudinaryUrl(request.resource.data.proofUrl))
        && (!request.resource.data.keys().hasAny(['receiptUrl'])
            || validCloudinaryUrl(request.resource.data.receiptUrl))
        && (!request.resource.data.keys().hasAny(['overdrawnBy'])
            || request.resource.data.overdrawnBy is int)
        && optStr(request.resource.data, 'vendor', 160)
        && optStr(request.resource.data, 'category', 60)
        && optStr(request.resource.data, 'location', 60)
        && (!request.resource.data.keys().hasAny(['missionDay'])
            || request.resource.data.missionDay is int);
      allow update, delete: if isAdmin();
    }

    // updates/{id} — published field reports (admin approval materializes
    // volunteer submissions here).
    match /updates/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // media/{id} — photo metadata. URLs must point at OUR Cloudinary
    // account's delivery host; captions bounded.
    match /media/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && validCloudinaryUrl(request.resource.data.cloudinaryUrl)
        && validCloudinaryUrl(request.resource.data.thumbnailUrl)
        && boundedStr(request.resource.data.caption, 300);
      allow update, delete: if isAdmin();
    }

    // stats/{id} — 'global' holds the hero totals (totalIn/totalOut/
    // familiesHelped), maintained by the money desk via batched
    // increments. Values must stay sane non-negative integers.
    match /stats/{id} {
      allow read: if true;
      allow write: if canWriteMoney()
        && request.resource.data.get('totalIn', 0) is int
        && request.resource.data.get('totalIn', 0) >= 0
        && request.resource.data.get('totalIn', 0) <= 100000000
        && request.resource.data.get('totalOut', 0) is int
        && request.resource.data.get('totalOut', 0) >= 0
        && request.resource.data.get('totalOut', 0) <= 100000000
        && request.resource.data.get('familiesHelped', 0) is int
        && request.resource.data.get('familiesHelped', 0) >= 0
        && request.resource.data.get('familiesHelped', 0) <= 1000000;
    }

    // accounts/{uid} — donor profiles (master §35–37: email+password
    // accounts replace the 6-digit code). Owner-only: a donor reads/writes
    // their own first name; nobody can list other donors' accounts.
    match /accounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // giftEmails/{donationId} — donor emails for manually recorded gifts
    // (final doc §58: the six-digit donor-code system is gone). The money
    // desk can CREATE one next to a donation; nobody can read or list them
    // from the client (PII). The linkMyDonations Cloud Function reads them
    // server-side (Admin SDK bypasses rules) to connect gifts to accounts.
    match /giftEmails/{donationId} {
      allow read: if false;
      allow create: if canWriteMoney()
        && boundedStr(request.resource.data.email, 320);
      allow update, delete: if false;
    }

    // settings/{id} — 'public' holds the launch mode (final doc §6–13):
    // 'preview' / 'live' / 'paused'. 'hero' holds the homepage slideshow
    // image list (max 30). Only an admin writes either, and only with
    // valid values — never an automatic count/amount/time trigger.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin() && (
        (id == 'public'
          && request.resource.data.get('mode', 'live') in ['preview', 'live', 'paused'])
        || (id == 'hero'
          && request.resource.data.get('images', []) is list
          && request.resource.data.get('images', []).size() <= 30)
      );
    }

    // events/{id} — 'current' holds the public fundraiser event (FINAL(2)
    // PART 54/70): everyone reads it (the /event page is public); only the
    // primary admin can publish or change it. HIGH-RISK: the ticket URL is
    // the donation destination — it may only be a Stripe payment link,
    // and event imagery must be bounded https URLs.
    match /events/{id} {
      allow read: if true;
      allow write: if isPrimaryAdmin()
        && validTicketUrl(request.resource.data.get('ticketUrl', null))
        && validImageUrl(request.resource.data.get('image', null))
        && validImageUrl(request.resource.data.get('imageEn', null))
        && validImageUrl(request.resource.data.get('imageEs', null));
    }

    // auditLogs/{id} — append-only administrative trail (WHO / WHAT /
    // WHEN). Any active staff account can APPEND their own entries (the
    // actor must be themselves); only admins can read them; NOBODY can
    // edit or delete history — not even an admin.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.actorUid == request.auth.uid
        && boundedStr(request.resource.data.action, 80)
        && request.resource.data.at is timestamp
        && optStr(request.resource.data, 'actorEmail', 200);
      allow update, delete: if false;
    }

    // campaigns/{id} — mini-campaigns ("a roof for Doña María"): the
    // public one-pager reads active ones live; any money-desk role can
    // manage them. Money is integer cents; imagery bounded https or a
    // bundled local path.
    match /campaigns/{id} {
      allow read: if true;
      allow write: if canWriteMoney()
        && boundedStr(request.resource.data.title, 120)
        && boundedStr(request.resource.data.titleEs, 120)
        && boundedStr(request.resource.data.story, 600)
        && boundedStr(request.resource.data.storyEs, 600)
        && validAmount(request.resource.data.goalCents)
        && request.resource.data.raisedCents is int
        && request.resource.data.raisedCents >= 0
        && request.resource.data.status in ['active', 'completed']
        && (validImageUrl(request.resource.data.get('imageUrl', null))
            || (request.resource.data.get('imageUrl', '') is string
                && request.resource.data.get('imageUrl', '').matches('^/[a-zA-Z0-9._-]{1,100}$')));
    }

    // stripeSessions/{sessionId} — written ONLY by the stripeWebhook Cloud
    // Function (Admin SDK bypasses rules). Fully closed to clients: the
    // public lookupDonation function reads it server-side and returns only
    // the confirmation status + donor code, never email or other PII.
    match /stripeSessions/{sessionId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
