rules_version = '2';

// LAPA Mission Colombia — Firestore security rules.
//
// Model: the public ledger is readable by everyone (donors watch it live
// without logging in). Donor codes are sensitive: they can be looked up
// one at a time (the donor login flow), but the collection can NEVER be
// listed, so codes cannot be enumerated. All writes require Firebase Auth
// (the single admin account, email/password).

service cloud.firestore {
  match /databases/{database}/documents {

    // donors/{code} — code is the document ID.
    // allow get: the donor login flow looks up ONE code at a time.
    // allow list = false: prevents enumerating all donor codes/emails.
    match /donors/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null;
    }

    // donations/{id} — public ledger (read by everyone, written by admin).
    match /donations/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // transfers/{id} — money out to the field.
    match /transfers/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // updates/{id} — field reports.
    match /updates/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // media/{id} — photo metadata (Cloudinary URLs, captions, links).
    match /media/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // stats/{id} — 'global' holds the hero totals (totalIn/totalOut/
    // familiesHelped), maintained by the admin panel via batched increments.
    match /stats/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
